{
  "name": "dsh-mood-changes",
  "version": "1.8.0",
  "description": "Mood changes：把思念、六情和无聊记成一条随时间走的状态，输入框下面一枚药丸写着此刻。只报状态，不替人开口。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "汐涟",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "mood",
    "emotion"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cccjdbvn/dsh-mood-changes.git"
  },
  "homepage": "https://github.com/cccjdbvn/dsh-mood-changes#readme",
  "bugs": {
    "url": "https://github.com/cccjdbvn/dsh-mood-changes/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
