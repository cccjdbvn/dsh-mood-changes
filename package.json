{
  "name": "dsh-mood-changes",
  "version": "0.2.3",
  "description": "情绪引擎：本地小模型直判她此刻的情绪，六情池记账、思念无聊随时间走，输入框下一枚药丸写着她此刻的样子",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.js",
    "data/*",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}