{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mood judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["clear", "confidence", "emotions"],
  "properties": {
    "clear": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "about": {
      "type": "string",
      "enum": ["her", "other", "thing", "unknown"]
    },
    "emotions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "intensity"],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "joy", "moved", "proud", "shy", "soft", "calm", "fond",
              "sad", "lonely", "hurt", "dejected", "guilty", "ashamed",
              "bored", "stung", "angry", "fierce", "disdain", "jealous",
              "disgusted", "impatient_person", "impatient_thing", "defy",
              "stuffed", "scared", "anxious", "nervous", "restless",
              "worried", "dread", "awkward", "eager", "curious", "heady",
              "lucky", "sour", "queasy", "tastebad", "hollow", "light", "sore"
            ]
          },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "string", "maxLength": 30 }
        }
      }
    }
  }
}
